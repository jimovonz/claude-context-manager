#!/bin/bash
# Claude Code launcher with CCM integration
#
# Usage:
#   c                    # Launch claude with proxy
#   c --resume abc123    # Resume a session
#   c -p "do something"  # Run with prompt
#
# Install:
#   ln -sf ~/.claude/hooks/c ~/.local/bin/c
#   # or add ~/.claude/hooks to PATH

set -e

# Read settings from config.py (env vars override)
CLAUDE_DIR="$HOME/.claude"
CONFIG_PY="$CLAUDE_DIR/hooks/config.py"

_read_config() {
    python3 -c "
import sys
sys.path.insert(0, '$CLAUDE_DIR/hooks')
try:
    from config import (
        AUTOCOMPACT_THRESHOLD, THINKING_PROXY_ENABLED, THINKING_PROXY_PORT,
        MAX_THINKING_TOKENS, OPENROUTER_API_KEY, EXTERNAL_COMPACTION_ENABLED,
        CONTEXT_MAX_TOKENS
    )
    # Import blocking margin with fallback for older configs
    try:
        from config import AUTOCOMPACT_BLOCKING_MARGIN
    except ImportError:
        AUTOCOMPACT_BLOCKING_MARGIN = 3  # Default 3% margin above compaction

    # Only use aggressive threshold if external compaction is available
    # Without OpenRouter, Claude needs its 22.5k buffer - use safer 85%
    has_external = bool(EXTERNAL_COMPACTION_ENABLED and OPENROUTER_API_KEY)
    threshold = AUTOCOMPACT_THRESHOLD if has_external else min(AUTOCOMPACT_THRESHOLD, 85)

    print(f'{threshold}')
    print(f'{THINKING_PROXY_ENABLED}')
    print(f'{THINKING_PROXY_PORT}')
    print(f'{MAX_THINKING_TOKENS}')
    print(f'{has_external}')
    print(f'{AUTOCOMPACT_BLOCKING_MARGIN}')
except Exception:
    print('85')
    print('True')
    print('8080')
    print('10000')
    print('False')
    print('3')  # default margin
" 2>/dev/null
}

_CONFIG_VALUES=($(_read_config))
_CFG_THRESHOLD="${_CONFIG_VALUES[0]:-85}"
_CFG_PROXY_ENABLED="${_CONFIG_VALUES[1]:-True}"
_CFG_PROXY_PORT="${_CONFIG_VALUES[2]:-8080}"
_CFG_THINKING_TOKENS="${_CONFIG_VALUES[3]:-10000}"
_CFG_HAS_EXTERNAL="${_CONFIG_VALUES[4]:-False}"
_CFG_BLOCKING_MARGIN="${_CONFIG_VALUES[5]:-3}"
COMPACT_PCT="${COMPACT_PCT:-$_CFG_THRESHOLD}"
MAX_THINKING="${MAX_THINKING_TOKENS:-$_CFG_THINKING_TOKENS}"
THINKING_PROXY_PORT="${THINKING_PROXY_PORT:-$_CFG_PROXY_PORT}"
THINKING_PROXY_ENABLED="${THINKING_PROXY_ENABLED:-$_CFG_PROXY_ENABLED}"
SKIP_PERMISSIONS="${SKIP_PERMISSIONS:-true}"
HAS_EXTERNAL_COMPACTION="$_CFG_HAS_EXTERNAL"

# Safety check: warn if threshold >85% without external compaction
if [[ "$HAS_EXTERNAL_COMPACTION" != "True" && "$COMPACT_PCT" -gt 85 ]] 2>/dev/null; then
    echo "[CCM] ⚠ WARNING: COMPACT_PCT=$COMPACT_PCT without OpenRouter API key" >&2
    echo "[CCM]   Claude needs ~20% buffer for its compaction summary." >&2
    echo "[CCM]   Values >85% may cause compaction failures. Capping at 85%." >&2
    COMPACT_PCT=85
fi

# Calculate blocking limit AFTER COMPACT_PCT is finalized (including env override and cap)
# Blocking limit = (COMPACT_PCT + margin)% of 200k, capped at 99%
_BLOCKING_PCT=$((COMPACT_PCT + _CFG_BLOCKING_MARGIN))
[[ $_BLOCKING_PCT -gt 99 ]] && _BLOCKING_PCT=99
BLOCKING_LIMIT="${BLOCKING_LIMIT:-$(( 200000 * _BLOCKING_PCT / 100 ))}"

PROXY_SCRIPT="$CLAUDE_DIR/hooks/thinking-proxy.py"
PATCHER_SCRIPT="$CLAUDE_DIR/hooks/patch-autocompact.py"

# Find session ID from args or most recent session
find_session_id() {
    local session_id=""
    local args=("$@")
    local i=0

    while [[ $i -lt ${#args[@]} ]]; do
        case "${args[i]}" in
            --resume=*)
                session_id="${args[i]#--resume=}"
                break
                ;;
            -r=*)
                session_id="${args[i]#-r=}"
                break
                ;;
            --resume|-r)
                if [[ $((i+1)) -lt ${#args[@]} ]]; then
                    session_id="${args[$((i+1))]}"
                    break
                fi
                ;;
        esac
        ((++i))
    done

    # If no explicit session, find most recent for current directory
    if [[ -z "$session_id" ]]; then
        local project_path
        project_path=$(pwd | sed 's|/|-|g')
        [[ "$project_path" != -* ]] && project_path="-$project_path"
        local sessions_dir="$CLAUDE_DIR/projects$project_path"

        if [[ -d "$sessions_dir" ]]; then
            session_id=$(find "$sessions_dir" -maxdepth 1 -name '*.jsonl' \
                -not -name '*backup*' -not -name 'agent-*' \
                -printf '%T@ %f\n' 2>/dev/null | sort -rn | head -1 | awk '{print $2}' | sed 's/\.jsonl$//')
        fi
    fi

    echo "$session_id"
}

# Ensure proxy is running
ensure_proxy() {
    if [[ -f "$PROXY_SCRIPT" ]]; then
        if command -v curl >/dev/null 2>&1; then
            if ! curl -s --connect-timeout 1 "http://127.0.0.1:$THINKING_PROXY_PORT/health" >/dev/null 2>&1; then
                "$PROXY_SCRIPT" start >/dev/null 2>&1 || true
                sleep 0.5
            fi
        else
            "$PROXY_SCRIPT" start >/dev/null 2>&1 || true
            sleep 0.5
        fi
    fi
}

# Get patched CLI (symlinked mirror that survives auto-updates)
get_patched_cli() {
    if [[ ! -f "$PATCHER_SCRIPT" ]]; then
        echo "[CCM] Patcher not found" >&2
        echo ""
        return 1
    fi

    # Get or create patched mirror
    local result
    result=$("$PATCHER_SCRIPT" --get-patched 2>&1)
    local exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        # First line is the path, rest is status message
        local patched_path
        patched_path=$(echo "$result" | head -1)
        if [[ -f "$patched_path" ]]; then
            echo "[CCM] Patches: OK" >&2
            echo "$patched_path"
            return 0
        fi
    fi

    # Patcher failed - try auto-repair
    local repair_script="$CLAUDE_DIR/hooks/patch-repair.py"
    if [[ -f "$repair_script" ]]; then
        echo "[CCM] Patches failed, attempting auto-repair..." >&2
        local repair_result
        repair_result=$("$repair_script" --verbose 2>&1)
        local repair_exit=$?

        # Show repair stderr output (progress messages)
        echo "$repair_result" | grep -v '^/' >&2

        if [[ $repair_exit -eq 0 ]]; then
            local repaired_path
            repaired_path=$(echo "$repair_result" | grep '^/' | tail -1)
            if [[ -f "$repaired_path" ]]; then
                echo "[CCM] Auto-repair: OK" >&2
                echo "$repaired_path"
                return 0
            fi
        fi
        echo "[CCM] Auto-repair: failed" >&2
    fi

    echo "[CCM] Patches: failed, using unpatched CLI" >&2
    echo ""
    return 1
}

# Repair broken session parent chains (runs quickly via cache)
repair_sessions() {
    local repair_script="$CLAUDE_DIR/hooks/repair-sessions.py"
    if [[ -f "$repair_script" ]]; then
        # Run quietly - only outputs if repairs are made
        python3 "$repair_script" --quiet 2>/dev/null || true
    fi
}

# Main
main() {
    # Trap 'c d..' typo (meant to type 'cd ..')
    if [[ "$1" =~ ^d\.+$ ]]; then
        local target="${1#d}"  # Strip leading 'd', leaving '..' or '...'
        echo "Caught typo: running 'cd $target' instead" >&2
        cd "$target"
        exec "$SHELL"
    fi

    # Repair any broken session chains before launching
    # (fast: uses hash cache to skip already-repaired sessions)
    repair_sessions

    local session_id
    session_id=$(find_session_id "$@")

    local env_vars=(
        "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=$COMPACT_PCT"
        "CLAUDE_CODE_BLOCKING_LIMIT_OVERRIDE=$BLOCKING_LIMIT"
        "MAX_THINKING_TOKENS=$MAX_THINKING"
        # Disable sidechain Session Memory compaction (2.1.27+)
        # SM_COMPACT stores summaries as sidechain entries which are filtered on resume
        # This forces inline compaction that the proxy can intercept for external routing
        "DISABLE_CLAUDE_CODE_SM_COMPACT=true"
    )

    if [[ "$THINKING_PROXY_ENABLED" == "True" ]]; then
        ensure_proxy
        env_vars+=("ANTHROPIC_BASE_URL=http://127.0.0.1:$THINKING_PROXY_PORT")
        if [[ -n "$session_id" ]]; then
            env_vars+=("ANTHROPIC_CUSTOM_HEADERS=X-CCM-Session-ID:$session_id")
        fi
    fi

    # Warn if external compaction not available
    if [[ "$HAS_EXTERNAL_COMPACTION" != "True" ]]; then
        echo "[CCM] ⚠ No OpenRouter API key - basic mode" >&2
        echo "[CCM]   Claude reserves ~20% context for its compaction summary." >&2
        echo "[CCM]   Threshold capped at ${COMPACT_PCT}% to preserve this buffer." >&2
        echo "[CCM]   With OpenRouter: external LLM handles compaction → 95% usable." >&2
        echo "[CCM]   Setup: ~/.claude-ccm/README.md#two-modes-of-operation" >&2
    fi

    # Get patched CLI (creates persistent copy that survives auto-updates)
    local patched_cli
    patched_cli=$(get_patched_cli)

    local cmd
    if [[ -n "$patched_cli" && -f "$patched_cli" ]]; then
        # Use patched copy (survives auto-updates)
        cmd=(env "${env_vars[@]}" node "$patched_cli")
    else
        # Fallback to system claude
        cmd=(env "${env_vars[@]}" claude)
    fi

    if [[ "$SKIP_PERMISSIONS" == "true" ]]; then
        cmd+=(--dangerously-skip-permissions)
    fi

    cmd+=("$@")

    exec "${cmd[@]}"
}

main "$@"
